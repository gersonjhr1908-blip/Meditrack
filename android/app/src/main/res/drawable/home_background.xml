<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="#EAF8F8" /></shape>
    </item>
    <item android:width="360dp" android:height="360dp" android:gravity="top|right" android:top="-120dp" android:right="-130dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="180dp"
                android:startColor="#B5E8EC" android:endColor="#00B5E8EC" />
        </shape>
    </item>
    <item android:width="340dp" android:height="340dp" android:gravity="left|center_vertical" android:left="-180dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="170dp"
                android:startColor="#B5E8EC" android:endColor="#00B5E8EC" />
        </shape>
    </item>
</layer-list>
