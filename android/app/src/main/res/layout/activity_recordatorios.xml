<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFD">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView41"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fondo5" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnVolverRecordatorios"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_arrow_back_24"
        android:contentDescription="Volver"
        android:scaleType="centerInside"
        android:padding="10dp"
        app:tint="#087EBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloRecordatorios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recordatorios"
        android:textColor="#102E67"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnVolverRecordatorios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVolverRecordatorios"
        app:layout_constraintBottom_toBottomOf="@id/btnVolverRecordatorios"
        app:layout_constraintHorizontal_bias="0.40" />

    <ScrollView
        android:id="@+id/scrollRecordatorios"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolverRecordatorios"
        app:layout_constraintBottom_toTopOf="@id/btnNuevoRecordatorio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<TextView android:id="@+id/tvSinRecordatorios" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="Aún no hay recordatorios para mostrar." android:textColor="#536A80" android:textSize="16sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">


            <!-- MEDICACIÓN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecordatorio1"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iconoMedicacion"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#FF9C4A"
                        android:contentDescription="Medicamento"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pildoras"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMedicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#142F6B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconoMedicacion"
                        app:layout_constraintEnd_toStartOf="@id/switchMedicacion"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDetalleMedicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconoMedicacion"
                        app:layout_constraintEnd_toStartOf="@id/switchMedicacion"
                        app:layout_constraintTop_toBottomOf="@id/tvMedicacion" />

                    <TextView
                        android:id="@+id/tvHoraMedicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/iconoMedicacion"
                        app:layout_constraintEnd_toStartOf="@id/switchMedicacion"
                        app:layout_constraintTop_toBottomOf="@id/tvDetalleMedicacion" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMedicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:scaleX="0.85"
                        android:scaleY="0.85"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#08B6B3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- GLUCOSA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecordatorio2"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iconoGlucosa"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#1689ED"
                        android:contentDescription="Medición de glucosa"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/estetoscopio"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvGlucosa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#142F6B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconoGlucosa"
                        app:layout_constraintEnd_toStartOf="@id/switchGlucosa"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDetalleGlucosa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconoGlucosa"
                        app:layout_constraintEnd_toStartOf="@id/switchGlucosa"
                        app:layout_constraintTop_toBottomOf="@id/tvGlucosa" />

                    <TextView
                        android:id="@+id/tvHoraGlucosa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/iconoGlucosa"
                        app:layout_constraintEnd_toStartOf="@id/switchGlucosa"
                        app:layout_constraintTop_toBottomOf="@id/tvDetalleGlucosa" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGlucosa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:scaleX="0.85"
                        android:scaleY="0.85"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#08B6B3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- CITA MÉDICA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecordatorio3"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iconoCita"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#FF6268"
                        android:contentDescription="Cita médica"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/alarma"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvCitaMedica"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#142F6B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconoCita"
                        app:layout_constraintEnd_toStartOf="@id/switchCita"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDetalleCita"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconoCita"
                        app:layout_constraintEnd_toStartOf="@id/switchCita"
                        app:layout_constraintTop_toBottomOf="@id/tvCitaMedica" />

                    <TextView
                        android:id="@+id/tvHoraCita"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/iconoCita"
                        app:layout_constraintEnd_toStartOf="@id/switchCita"
                        app:layout_constraintTop_toBottomOf="@id/tvDetalleCita" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchCita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:scaleX="0.85"
                        android:scaleY="0.85"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#08B6B3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- EJERCICIO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecordatorio4"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="15dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iconoEjercicio"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#08A8ED"
                        android:contentDescription="Ejercicio"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/citasicono"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvEjercicio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#142F6B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iconoEjercicio"
                        app:layout_constraintEnd_toStartOf="@id/switchEjercicio"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDetalleEjercicio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconoEjercicio"
                        app:layout_constraintEnd_toStartOf="@id/switchEjercicio"
                        app:layout_constraintTop_toBottomOf="@id/tvEjercicio" />

                    <TextView
                        android:id="@+id/tvHoraEjercicio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        android:textColor="#6B83A6"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/iconoEjercicio"
                        app:layout_constraintEnd_toStartOf="@id/switchEjercicio"
                        app:layout_constraintTop_toBottomOf="@id/tvDetalleEjercicio" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEjercicio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:scaleX="0.85"
                        android:scaleY="0.85"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="#08B6B3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
</LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevoRecordatorio"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:text="Nuevo recordatorio"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#08B6B3"
        app:cornerRadius="28dp"
        app:elevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
