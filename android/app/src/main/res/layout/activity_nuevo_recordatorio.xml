<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFD"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnVolverNuevoRecordatorio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/outline_arrow_back_24"
                app:tint="#087EBD" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Nuevo recordatorio"
                android:textColor="#102E67"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />

        </LinearLayout>

        <!-- TARJETA INFORMATIVA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#E0F7F5"
                    android:contentDescription="Recordatorio de salud"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/alarma" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cuida tu salud"
                        android:textColor="#102E67"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Organiza tus actividades y no olvides tus cuidados diarios."
                        android:textColor="#6B83A6"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TIPO DE RECORDATORIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Tipo de recordatorio"
            android:textColor="#102E67"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTipoRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_medicamento"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <!-- NOMBRE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Nombre del recordatorio"
            android:textColor="#102E67"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_medicamento"
            android:hint="Ej. Tomar medicamento"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#102E67"
            android:textColorHint="#8CA0B8"
            android:textSize="14sp" />

        <!-- DETALLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Detalle o indicación"
            android:textColor="#102E67"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDetalleRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_campo_medicamento"
            android:gravity="top|start"
            android:hint="Ej. Tomar después del desayuno"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textColor="#102E67"
            android:textColorHint="#8CA0B8"
            android:textSize="14sp" />

        <!-- HORA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Hora del recordatorio"
            android:textColor="#102E67"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHoraRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#FFFFFF"
            android:text="Seleccionar hora"
            android:textAllCaps="false"
            android:textColor="#087EBD"
            app:cornerRadius="12dp"
            app:strokeColor="#D8E7EF"
            app:strokeWidth="1dp"
            app:icon="@drawable/alarma"
            app:iconTint="#087EBD"
            app:iconGravity="textStart" />

        <!-- FRECUENCIA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Frecuencia"
            android:textColor="#102E67"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spFrecuenciaRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_medicamento"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:spinnerMode="dropdown" />

        <!-- FECHA DE INICIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Fecha de inicio"
            android:textColor="#102E67"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFechaRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#FFFFFF"
            android:text="Seleccionar fecha"
            android:textAllCaps="false"
            android:textColor="#087EBD"
            app:cornerRadius="12dp"
            app:strokeColor="#D8E7EF"
            app:strokeWidth="1dp" />

        <!-- ESTADO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activar recordatorio"
                        android:textColor="#102E67"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Podrás desactivarlo después"
                        android:textColor="#6B83A6"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNuevoRecordatorio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="#08B6B3" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GUARDAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Guardar recordatorio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#08B6B3"
            app:cornerRadius="28dp"
            app:elevation="3dp" />

        <!-- CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#087EBD"
            android:backgroundTint="#E0F7F5"
            app:cornerRadius="28dp" />

    </LinearLayout>

</ScrollView>
