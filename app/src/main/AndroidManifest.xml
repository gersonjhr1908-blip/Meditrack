            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Registro.RegistroEnfermeraActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Registro.RegistroPacienteActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
