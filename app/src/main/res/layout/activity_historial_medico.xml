<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFD">

    <!-- ENCABEZADO -->
    <ImageButton
        android:id="@+id/btnVolverHistorial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_arrow_back_24"
        android:contentDescription="Volver"
        android:padding="10dp"
        app:tint="#087EBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTituloHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial Médico"
        android:textColor="#102E67"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnVolverHistorial"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVolverHistorial"
        app:layout_constraintBottom_toBottomOf="@id/btnVolverHistorial"
        app:layout_constraintHorizontal_bias="0.40"/>

    <!-- PESTAÑAS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPestanasHistorial"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="#E4F0F9"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolverHistorial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvResumenHistorial"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#08B6B3"
                android:gravity="center"
                android:text="Resumen"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDocumentosHistorial"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Documentos"
                android:textColor="#54749B"
                android:textSize="12sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/scrollHistorial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardPestanasHistorial"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="Aún no hay registros médicos para mostrar." android:textColor="#536A80" android:textSize="16sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">


            <!-- SECCIÓN DIAGNÓSTICOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="7dp"
                android:text=""
                android:textColor="#174B91"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <!-- DIABETES -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDiabetes"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgDiabetesHistorial"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Diabetes tipo 2"
                        android:src="@drawable/alarma"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDiabetesHistorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgDiabetesHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaDiabetes"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgDiabetesHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaDiabetes"
                        app:layout_constraintTop_toBottomOf="@id/tvDiabetesHistorial"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgDiabetesHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaDiabetes"
                        app:layout_constraintTop_toBottomOf="@id/tvDiabetesHistorial"
                        android:layout_marginTop="13dp"/>

                    <ImageView
                        android:id="@+id/flechaDiabetes"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ver detalle"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- GLUCOSA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGlucosaHistorial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgGlucosaHistorial"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Glucosa"
                        android:src="@drawable/alarma"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvGlucosaHistorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgGlucosaHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaGlucosa"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgGlucosaHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaGlucosa"
                        app:layout_constraintTop_toBottomOf="@id/tvGlucosaHistorial"/>

                    <ImageView
                        android:id="@+id/flechaGlucosa"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ver detalle"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- PRESIÓN ARTERIAL -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPresionHistorial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgPresionHistorial"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Presión arterial"
                        android:src="@drawable/alarma"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPresionHistorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgPresionHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaPresion"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgPresionHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaPresion"
                        app:layout_constraintTop_toBottomOf="@id/tvPresionHistorial"/>

                    <ImageView
                        android:id="@+id/flechaPresion"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ver detalle"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- PESO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPesoHistorial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgPesoHistorial"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Peso"
                        android:src="@drawable/citasicono"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPesoHistorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgPesoHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaPeso"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgPesoHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaPeso"
                        app:layout_constraintTop_toBottomOf="@id/tvPesoHistorial"/>

                    <ImageView
                        android:id="@+id/flechaPeso"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ver detalle"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- IMC -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardImcHistorial"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgImcHistorial"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="Índice de masa corporal"
                        android:src="@drawable/alarma"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvImcHistorial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgImcHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaImc"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgImcHistorial"
                        app:layout_constraintEnd_toStartOf="@id/flechaImc"
                        app:layout_constraintTop_toBottomOf="@id/tvImcHistorial"/>

                    <ImageView
                        android:id="@+id/flechaImc"
                        android:layout_width="20dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ver detalle"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ÚLTIMAS CONSULTAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#174B91"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#08B6B3"
                    android:textSize="10sp"/>

            </LinearLayout>

            <!-- CONSULTA MÉDICA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUltimaConsulta"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="13dp"
                app:cardElevation="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp">

                    <ImageView
                        android:id="@+id/imgConsultaHistorial"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Consulta general"
                        android:src="@drawable/citasicono"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvConsultaGeneral"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text=""
                        android:textColor="#174B91"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgConsultaHistorial"
                        app:layout_constraintEnd_toStartOf="@id/tvFechaConsulta"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="#6683A5"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgConsultaHistorial"
                        app:layout_constraintEnd_toStartOf="@id/tvFechaConsulta"
                        app:layout_constraintTop_toBottomOf="@id/tvConsultaGeneral"/>

                    <TextView
                        android:id="@+id/tvFechaConsulta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#08B6B3"
                        android:textSize="9sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
</LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
