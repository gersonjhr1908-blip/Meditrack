<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#F4FAFD"
    app:cardCornerRadius="15dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="#183C70"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEP"
                android:textColor="#08AAA9"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="9dp"
            android:background="#DCECF5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medicina General"
                android:textColor="#183C70"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMedico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr. Carlos Ramírez"
                android:textColor="#55769C"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 a. m."
                android:textColor="#55769C"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFF0D9"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="Pendiente"
            android:textColor="#B77A20"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
