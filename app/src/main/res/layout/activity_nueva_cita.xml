<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cita_screen_background"
    tools:context=".Citas.NuevaCita">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView42"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:srcCompat="@drawable/fondo3" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/btnCancelar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/cita_back_background"
                android:contentDescription="Regresar"
                android:padding="10dp"
                android:src="@drawable/outline_arrow_back_24"
                app:tint="#183C70" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Agendar nueva cita"
                android:textColor="#183C70"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Completa los datos de tu consulta médica."
                android:textColor="#4F6A7E"
                android:textSize="14sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/cita_card_background"
                android:elevation="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Especialidad médica"
                android:textColor="#183C70"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/cita_field_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Médico"
                android:textColor="#183C70"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/etMedico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Seleccionar médico"
                android:background="@drawable/cita_field_background"
                android:padding="12dp"
                android:textColor="#183C70"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Fecha de la cita"
                android:textColor="#183C70"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFecha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/cita_action_background"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_calendar_teal"
                app:iconTint="#0A7480"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:stateListAnimator="@null"
                android:text="Seleccionar fecha"
                android:textAllCaps="false"
                android:textColor="#0A7480"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Hora de la cita"
                android:textColor="#183C70"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHora"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/cita_action_background"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_clock_teal"
                app:iconTint="#0A7480"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                android:stateListAnimator="@null"
                android:text="Seleccionar hora"
                android:textAllCaps="false"
                android:textColor="#0A7480"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Motivo de la consulta"
                android:textColor="#183C70"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMotivo"
                android:maxLength="250"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/cita_field_background"
                android:minHeight="96dp"
                android:elevation="3dp"
                android:gravity="top|start"
                android:hint="Describe el motivo de tu consulta"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp"
                android:textColor="#183C70"
                android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/cita_confirm_selector"
                android:backgroundTint="@null"
                android:text="Confirmar solicitud"
                android:textAllCaps="false"
                android:textColor="@color/cita_confirm_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
