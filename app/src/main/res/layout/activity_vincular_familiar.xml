<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFD">

    <!-- Botón volver -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView40"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fondo3" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btnVolverVincularFamiliar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="12dp"
        android:src="@drawable/outline_arrow_back_24"
        android:contentDescription="Volver"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloVincularFamiliar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vincular familiar"
        android:textColor="#183B70"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnVolverVincularFamiliar"
        app:layout_constraintBottom_toBottomOf="@id/btnVolverVincularFamiliar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolverVincularFamiliar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Comparte este código con tu familiar\npara que pueda solicitar la vinculación"
                android:textColor="#7890AB"
                android:textSize="13sp" />

            <!-- Código QR -->
            <androidx.cardview.widget.CardView
                android:layout_width="142dp"
                android:layout_height="142dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <ImageView
                    android:id="@+id/imgCodigoQRVinculacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Código QR de vinculación"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/perfil" />

            </androidx.cardview.widget.CardView>

            <!-- Código de vinculación -->
            <TextView
                android:id="@+id/tvCodigoVinculacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="•  MT-7K4P92  •"
                android:textColor="#183B70"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Tiempo de validez -->
            <TextView
                android:id="@+id/tvValidezCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Válido por 10 minutos"
                android:textColor="#7890AB"
                android:textSize="12sp" />

            <!-- Compartir código -->
            <Button
                android:id="@+id/btnCompartirCodigo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="26dp"
                android:background="@android:color/transparent"
                android:elevation="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Compartir código"
                android:textAllCaps="false"
                android:textColor="#4DD7C1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Generar nuevo código -->
            <TextView
                android:id="@+id/tvGenerarNuevoCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="8dp"
                android:text="Generar un nuevo código"
                android:textColor="#2478B8"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
