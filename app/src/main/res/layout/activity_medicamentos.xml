<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FAFD">

    <!-- ENCABEZADO -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView38"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/fondo5" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnVolverMedicamentos"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_arrow_back_24"
        android:contentDescription="Volver"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:tint="#087EBD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvTituloMedicamentos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medicamentos"
        android:textColor="#102E67"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnVolverMedicamentos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVolverMedicamentos"
        app:layout_constraintBottom_toBottomOf="@id/btnVolverMedicamentos"
        app:layout_constraintHorizontal_bias="0.40"/>

    <!-- PESTAÑAS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPestanasMedicamentos"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#E3F0F9"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolverMedicamentos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvMedicamentosActivos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#08B6B3"
                android:gravity="center"
                android:text="Activos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMedicamentosFinalizados"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Finalizados"
                android:textColor="#59769D"
                android:textSize="12sp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- LISTA DE MEDICAMENTOS -->
    <ScrollView
        android:id="@+id/scrollMedicamentos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cardPestanasMedicamentos"
        app:layout_constraintBottom_toTopOf="@id/btnAgregarMedicamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<TextView android:id="@+id/tvSinMedicamentos" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="Aún no hay medicamentos para mostrar." android:textColor="#536A80" android:textSize="16sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">


            <!-- METFORMINA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMetformina"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp">

                    <ImageView
                        android:id="@+id/imgMetformina"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Metformina"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pildoras"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvMetformina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#102E67"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgMetformina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleMetformina"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvDosisMetformina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/imgMetformina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleMetformina"
                        app:layout_constraintTop_toBottomOf="@id/tvMetformina"/>

                    <TextView
                        android:id="@+id/tvFrecuenciaMetformina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgMetformina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleMetformina"
                        app:layout_constraintTop_toBottomOf="@id/tvDosisMetformina"/>

                    <ImageView
                        android:id="@+id/btnDetalleMetformina"
                        android:layout_width="24dp"
                        android:layout_height="32dp"
                        android:contentDescription="Ver detalles"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- INSULINA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInsulina"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp">

                    <ImageView
                        android:id="@+id/imgInsulina"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Insulina"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pildoras"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvInsulina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#102E67"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgInsulina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleInsulina"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvDosisInsulina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/imgInsulina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleInsulina"
                        app:layout_constraintTop_toBottomOf="@id/tvInsulina"/>

                    <TextView
                        android:id="@+id/tvFrecuenciaInsulina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgInsulina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleInsulina"
                        app:layout_constraintTop_toBottomOf="@id/tvDosisInsulina"/>

                    <ImageView
                        android:id="@+id/btnDetalleInsulina"
                        android:layout_width="24dp"
                        android:layout_height="32dp"
                        android:contentDescription="Ver detalles"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- OMEPRAZOL -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOmeprazol"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp">

                    <ImageView
                        android:id="@+id/imgOmeprazol"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Omeprazol"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pildoras"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvOmeprazol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#102E67"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgOmeprazol"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleOmeprazol"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvDosisOmeprazol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/imgOmeprazol"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleOmeprazol"
                        app:layout_constraintTop_toBottomOf="@id/tvOmeprazol"/>

                    <TextView
                        android:id="@+id/tvFrecuenciaOmeprazol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgOmeprazol"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleOmeprazol"
                        app:layout_constraintTop_toBottomOf="@id/tvDosisOmeprazol"/>

                    <ImageView
                        android:id="@+id/btnDetalleOmeprazol"
                        android:layout_width="24dp"
                        android:layout_height="32dp"
                        android:contentDescription="Ver detalles"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- ATORVASTATINA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAtorvastatina"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="9dp">

                    <ImageView
                        android:id="@+id/imgAtorvastatina"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Atorvastatina"
                        android:scaleType="fitCenter"
                        android:src="@drawable/pildoras"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAtorvastatina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#102E67"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgAtorvastatina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleAtorvastatina"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/tvDosisAtorvastatina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/imgAtorvastatina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleAtorvastatina"
                        app:layout_constraintTop_toBottomOf="@id/tvAtorvastatina"/>

                    <TextView
                        android:id="@+id/tvFrecuenciaAtorvastatina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text=""
                        android:textColor="#54749B"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@id/imgAtorvastatina"
                        app:layout_constraintEnd_toStartOf="@id/btnDetalleAtorvastatina"
                        app:layout_constraintTop_toBottomOf="@id/tvDosisAtorvastatina"/>

                    <ImageView
                        android:id="@+id/btnDetalleAtorvastatina"
                        android:layout_width="24dp"
                        android:layout_height="32dp"
                        android:contentDescription="Ver detalles"
                        android:src="@drawable/outline_arrow_forward_ios_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
</LinearLayout>
    </ScrollView>

    <!-- BOTÓN AGREGAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregarMedicamento"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:text="Agregar medicamento"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#08B6B3"
        app:cornerRadius="26dp"
        app:elevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
