<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeIconShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">17dp</item>
    </style>
    <style name="HomeSectionTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#0B2E4F</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HomeSectionLink">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#0A7480</item>
    </style>
    <style name="HomeShortcutCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">116dp</item>
        <item name="android:layout_weight">1</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>
    <style name="HomeShortcutIcon">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="HomeShortcutLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#0B2E4F</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HomeNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="HomeNavIcon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:paddingStart">19dp</item>
        <item name="android:paddingEnd">19dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="HomeNavLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">bottom|center_horizontal</item>
        <item name="android:gravity">bottom|center_horizontal</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#4F6A7E</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
